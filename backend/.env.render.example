DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_SUPABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
REDIS_URL="rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_UPSTASH_ENDPOINT:6379"
JWT_SECRET="replace-with-a-long-random-production-secret"
JWT_REFRESH_SECRET="replace-with-a-second-long-random-production-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
# Supabase Dashboard > Project Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET="replace-with-supabase-jwt-secret-from-dashboard"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
PORT=10000
NODE_ENV=production
# รองรับหลาย domain คั่นด้วยจุลภาค
CORS_ORIGIN="https://your-frontend-domain.vercel.app"
FRONTEND_URL="https://your-frontend-domain.vercel.app"
