# ============================================================
# NimittHIS — Backend Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าที่เหมาะสม
# ============================================================

# Database
# Local Postgres:
DATABASE_URL="postgresql://user:pass@localhost:5432/nimitthis"
# Supabase (Render/Cloud):
# DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_SUPABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Redis
# Local Redis:
REDIS_URL="redis://localhost:6379"
# Upstash (Render/Cloud):
# REDIS_URL="rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_UPSTASH_ENDPOINT:6379"

# JWT — ใช้สำหรับ API clients ที่ login ผ่าน /api/auth/login โดยตรง
JWT_SECRET="your-secret-key-min-32-characters-long"
JWT_REFRESH_SECRET="your-refresh-secret-min-16-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Supabase — ดูได้ที่ Supabase Dashboard > Project Settings > API > JWT Settings > JWT Secret
# ใช้สำหรับ verify token จาก frontend ที่ login ผ่าน Supabase Auth
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-from-dashboard"

# SMS (Twilio) — ถ้าไม่ตั้งค่า SMS จะถูก mock (delivered: false)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
# รองรับหลาย origin คั่นด้วยจุลภาค (ไม่มีช่องว่าง)
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"
