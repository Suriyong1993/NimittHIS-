# Database
# Local Postgres:
DATABASE_URL="postgresql://user:pass@localhost:5432/nimitthis"
# Supabase on Render:
# DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_SUPABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Redis
# Local Redis:
REDIS_URL="redis://localhost:6379"
# Upstash on Render:
# REDIS_URL="rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_UPSTASH_ENDPOINT:6379"

# JWT
JWT_SECRET="your-secret-key-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# SMS (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"
